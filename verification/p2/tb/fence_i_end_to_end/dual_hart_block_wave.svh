// Read-only, selected-net VCD monitor for the two-hart TOP test.
  integer profile_wave_fd = 0;
  string profile_wave_path;
  integer profile_wave_start, profile_wave_end;
  initial begin
    profile_wave_start = 0;
    profile_wave_end = 20000;
    void'($value$plusargs("TRACE_START_NS=%d", profile_wave_start));
    void'($value$plusargs("TRACE_END_NS=%d", profile_wave_end));
    if ($value$plusargs("BLOCK_WAVE=%s", profile_wave_path)) begin
      profile_wave_fd = $fopen(profile_wave_path, "w");
      if (profile_wave_fd == 0) $fatal(1, "Cannot open selected-net VCD");
      $fdisplay(profile_wave_fd, "$timescale 1ns $end");
      $fdisplay(profile_wave_fd, "$scope module top $end");
      $fdisplay(profile_wave_fd, "$scope module clock_irq_debug $end");
      $fdisplay(profile_wave_fd, "$var wire %0d v0 i_clk_cluster $end", $bits(i_clk_cluster));
      $fdisplay(profile_wave_fd, "$var wire %0d v1 i_rst_n_cluster $end", $bits(i_rst_n_cluster));
      $fdisplay(profile_wave_fd, "$var wire %0d v2 i_boot_addr $end", $bits(i_boot_addr));
      $fdisplay(profile_wave_fd, "$var wire %0d v3 i_int_msip $end", $bits(i_int_msip));
      $fdisplay(profile_wave_fd, "$var wire %0d v4 i_int_mtip $end", $bits(i_int_mtip));
      $fdisplay(profile_wave_fd, "$var wire %0d v5 i_int_meip $end", $bits(i_int_meip));
      $fdisplay(profile_wave_fd, "$var wire %0d v6 i_int_ssip $end", $bits(i_int_ssip));
      $fdisplay(profile_wave_fd, "$var wire %0d v7 i_int_stip $end", $bits(i_int_stip));
      $fdisplay(profile_wave_fd, "$var wire %0d v8 i_int_seip $end", $bits(i_int_seip));
      $fdisplay(profile_wave_fd, "$var wire %0d v9 i_hart_debug_req $end", $bits(i_hart_debug_req));
      $fdisplay(profile_wave_fd, "$var wire %0d v10 o_hart_debug_mode $end", $bits(o_hart_debug_mode));
      $fdisplay(profile_wave_fd, "$var wire %0d v11 o_int_pmu $end", $bits(o_int_pmu));
      $fdisplay(profile_wave_fd, "$var wire %0d v12 o_int_fault $end", $bits(o_int_fault));
      $fdisplay(profile_wave_fd, "$upscope $end");
      $fdisplay(profile_wave_fd, "$scope module axil $end");
