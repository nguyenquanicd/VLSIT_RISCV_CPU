      ["ENUM_ST_ABORT_WAIT", "ENUM_ST_GNT", "root ABORT ACKs without reservation"],
      ["ENUM_ST_DIR_UPDATE", "ENUM_ST_GNT", "matching bank UPDATE accepted"],
