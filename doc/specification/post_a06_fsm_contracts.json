    "states": ["ENUM_ST_IDLE", "ENUM_ST_DIR_REQ", "ENUM_ST_DIR_WAIT", "ENUM_ST_EVICT_ALLOC", "ENUM_ST_EVICT_WAIT", "ENUM_ST_OWNER", "ENUM_ST_PREP_START", "ENUM_ST_PREP_WAIT", "ENUM_ST_COMMIT_START", "ENUM_ST_COMMIT_WAIT", "ENUM_ST_ABORT_START", "ENUM_ST_ABORT_WAIT", "ENUM_ST_DIR_UPDATE", "ENUM_ST_DIR_CANCEL", "ENUM_ST_GNT", "ENUM_ST_GNT_WAIT", "ENUM_ST_CMO_PREPARED", "ENUM_ST_CMO_FINISH", "ENUM_ST_RETRY_CANCEL"],
    "transitions": [
