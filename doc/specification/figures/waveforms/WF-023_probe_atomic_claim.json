      {
        "name": "H3 PREPARE tag",
        "wave": "====",
        "data": ["-", "T0", "-", "T1"]
      }
    ],
    [
      "Waiting context",
      {
        "name": "T1 holds per-hart slot",
        "wave": "0000"
      },
      {
        "name": "T1 status",
        "wave": "====",
        "data": ["waiting, no claim", "waiting, no claim", "claim both", "PREPARE active"]
      }
