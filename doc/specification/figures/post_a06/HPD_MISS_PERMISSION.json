    {
      "src": "MISS_REQ_OWN_WAIT",
      "dst": "MISS_REQ_OWN_ERROR",
      "label": "grant received but mismatch, error or illegal permission"
    },
    {
      "src": "MISS_REQ_SEND",
      "dst": "MISS_REQ_IDLE",
      "label": "mem_req_ready_i"
    },
    {
      "src": "MISS_REQ_OWN_ERROR",
      "dst": "MISS_REQ_IDLE",
      "label": "failed response consumed with last"
    }
  ],
  "layout": {
    "margin": 50
  }
}
