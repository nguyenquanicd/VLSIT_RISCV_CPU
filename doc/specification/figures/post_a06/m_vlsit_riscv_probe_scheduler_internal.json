  ],
  "blocks": [
    {
      "key": "B0",
      "label": [
        "claim_arbiter",
        "(p_com_probe_claim)"
      ],
      "width": 220,
      "row": 0,
      "col": 0,
      "row_name": "claim_arbiter (p_com_probe_claim)",
      "function": "Grant one new context per cycle, and only when every hart slot of its expected mask is free (REQ-MEM-024).",
      "source": "rtl/common/vlsit/coherence/m_vlsit_riscv_probe_scheduler.sv:134-183"
    },
    {
      "key": "B1",
      "label": [
        "phase_owner_slots",
        "(per-hart owner tag)"
      ],
      "width": 240,
      "row": 0,
      "col": 1,
      "row_name": "phase_owner_slots (per-hart owner tag)",
      "function": "Keep, for each hart, the tag of the context that owns its probe slot from PREPARE to COMMIT or ABORT.",
      "source": "rtl/common/vlsit/coherence/m_vlsit_riscv_probe_scheduler.sv:233-309"
    },
    {
      "key": "B2",
      "label": [
        "target_select",
        "(p_com_probe_sel)"
      ],
      "width": 200,
      "row": 1,
      "col": 0,
      "row_name": "target_select (p_com_probe_sel)",
      "function": "Scan active contexts round robin for each hart and pick only expected targets that have not acknowledged yet.",
      "source": "rtl/common/vlsit/coherence/m_vlsit_riscv_probe_scheduler.sv:185-212"
    },
    {
      "key": "B3",
      "label": [
        "probe_request_regs",
        "(per-hart request)"
      ],
      "width": 220,
      "row": 1,
      "col": 1,
      "row_name": "probe_request_regs (per-hart request)",
      "function": "Hold tag, line, phase, target state and write-back enable stable while the cache is not ready.",
      "source": "rtl/common/vlsit/coherence/m_vlsit_riscv_probe_scheduler.sv:214-232"
    },
    {
      "key": "B4",
      "label": [
        "active_probe_tracker",
        "(p_ff_probe_schedule)"
      ],
      "width": 260,
      "row": 2,
      "col": 1,
      "row_name": "active_probe_tracker (p_ff_probe_schedule)",
      "function": "Remember which probe is outstanding on each hart and its phase-owner association.",
      "source": "rtl/common/vlsit/coherence/m_vlsit_riscv_probe_scheduler.sv:233-309"
    },
    {
      "key": "B5",
      "label": [
        "ack_match_buffer",
        "(response match)"
      ],
      "width": 200,
      "row": 2,
      "col": 0,
      "row_name": "ack_match_buffer (response match)",
      "function": "Match response tag, line and phase, hold the ACK until the transaction table accepts it, and drain a mismatch into a diagnostic event.",
      "source": "rtl/common/vlsit/coherence/m_vlsit_riscv_probe_scheduler.sv:214-309"
    }
  ],
