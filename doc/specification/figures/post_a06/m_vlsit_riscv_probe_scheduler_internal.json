  "frame_row": [
    "m_vlsit_riscv_probe_scheduler",
    "Schedule one tagged probe per cache and route the matching response.",
    "rtl/common/vlsit/coherence/m_vlsit_riscv_probe_scheduler.sv"
  ],
  "frame_interfaces": [
    "CTXI",
    "PRBO",
    "RSPI",
