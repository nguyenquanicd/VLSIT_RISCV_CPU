        <mxCell id="70" parent="1" vertex="1" value="Cuts array read from compare. Lookup accepted at E reaches the response register at E+1 when unstalled." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontStyle=0;">
          <mxGeometry x="216" y="344" width="1292" height="23" as="geometry" />
        </mxCell>
        <mxCell id="71" parent="1" vertex="1" value="Reset release" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=19;fontStyle=1;">
          <mxGeometry x="32" y="400" width="182" height="24" as="geometry" />
        </mxCell>
        <mxCell id="72" parent="1" vertex="1" value="A local flop releases handshake gating. AXI4-Lite control has no dedicated TOP spill in this RTL." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontStyle=0;">
          <mxGeometry x="216" y="400" width="1292" height="23" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
