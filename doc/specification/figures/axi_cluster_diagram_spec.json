 "interfaces": [
  {
   "id": "IRQ",
   "name": "Per-hart platform interrupt inputs",
   "category": "external interrupt",
   "active": "SoC interrupt controller -> CPU tile array",
   "signals": "i_int_msip[3:0], i_int_mtip[3:0], i_int_meip[3:0], i_int_ssip[3:0], i_int_stip[3:0], i_int_seip[3:0]"
  },
  {
   "id": "DBG",
   "name": "External Debug Module connection",
   "category": "debug control",
   "active": "External DM -> debug adapter",
   "signals": "i_hart_debug_req[3:0]; o_hart_debug_mode[3:0]"
  },
  {
   "id": "AXIL",
   "name": "AXI4-Lite control subordinate",
   "category": "standard protocol",
   "active": "SoC manager -> cluster subordinate",
   "signals": "32-bit address/data, AW/W/B/AR/R channels"
  },
  {
   "id": "MMIO",
   "name": "AXI4 peripheral manager",
   "category": "standard protocol",
   "active": "Cluster -> peripheral fabric",
   "signals": "64-bit address/data, 4-bit ID, AXI4 AW/W/B/AR/R channels"
  },
  {
   "id": "MEM",
   "name": "AXI4 non-coherent memory manager",
   "category": "standard protocol",
   "active": "Cluster -> memory fabric",
   "signals": "64-bit address/data, 4-bit ID, AXI4 AW/W/B/AR/R channels; no external snoops"
  },
  {
   "id": "PMIRQ",
   "name": "Aggregate PMU interrupt output",
   "category": "interrupt",
   "active": "Cluster PMU -> SoC interrupt controller",
   "signals": "o_int_pmu"
  },
  {
   "id": "CLKR",
   "name": "Cluster clock and reset",
   "category": "clock/reset",
   "active": "SoC clock/reset controller -> cluster",
   "signals": "i_clk_cluster, i_rst_n_cluster"
  },
  {
   "id": "TREQ",
   "name": "Tile cache request path",
   "category": "internal coherence",
   "active": "CPU tile array -> coherence fabric",
   "signals": "Cacheable read/write requests and ownership operations"
  },
  {
   "id": "TRES",
   "name": "Tile coherence response path",
   "category": "internal coherence",
   "active": "Coherence fabric -> CPU tile array",
   "signals": "Data, completion, and probe responses"
  },
  {
   "id": "LREQ",
   "name": "LLC request path",
   "category": "internal memory path",
   "active": "Coherence fabric -> LLC",
   "signals": "Shared cache-line requests and writeback data"
  },
  {
   "id": "LRES",
   "name": "LLC response path",
   "category": "internal memory path",
   "active": "LLC -> coherence fabric",
   "signals": "Cache-line data and completion"
  },
  {
   "id": "DREQ",
   "name": "Non-coherent device request",
   "category": "internal device path",
   "active": "Coherence fabric -> AXI4 MMIO router",
   "signals": "Non-cacheable device read/write requests, routed from the coherence-fabric device path to the MMIO manager."
  },
  {
   "id": "DRES",
   "name": "Non-coherent device response",
   "category": "internal device path",
   "active": "AXI4 MMIO router -> coherence fabric",
   "signals": "Device read data and AXI response, returned to the coherence-fabric requester."
  },
  {
   "id": "EVTS",
   "name": "Aggregated cluster performance events",
   "category": "performance events",
   "active": "hart, coherence, LLC -> PMU",
   "signals": "The coherence observability tap aggregates event vectors from the CPU tiles, coherence fabric and LLC and presents them to the PMU."
  },
  {
   "id": "CFG",
   "name": "PMU configuration",
   "category": "internal CSR",
   "active": "CSR block -> PMU",
   "signals": "Event selector, counter enable, snapshot and cause control"
  },
  {
   "id": "LLCFG",
   "name": "LLC service controls",
   "category": "internal CSR",
   "active": "CSR decoder -> LLC",
   "signals": "BIST/flush/counter service access; SPM disabled"
  },
  {
   "id": "HDBG",
   "name": "Per-hart debug routing",
   "category": "debug control",
   "active": "Debug adapter -> CPU tiles",
   "signals": "Per-hart request and mode/status"
  }
 ],
 "legend_note": "AXI profile has no external ACE snoop interface. External DMA visibility requires the SoC software cache-maintenance contract."
}
