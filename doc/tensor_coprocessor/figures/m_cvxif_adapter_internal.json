  "frame_row": [
    "m_cvxif_adapter",
    "CV-X-IF handshake, decode, admission, command queue, authorization and dispatch.",
    "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 5.3"
  ],
  "frame_interfaces": [
    "ISS",
    "CMT",
    "RESX",
    "CTL"
  ],
  "blocks": [
    {
      "key": "B0",
      "label": [
        "endpoint_decode",
        "(per hart)"
      ],
      "width": 180,
      "row": 0,
      "col": 0,
      "row_name": "endpoint_decode (per hart)",
      "function": "Decode operation, precision and result class for each hart and answer the issue with accept and register-read without depending on ready.",
      "source": "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 5.3.3"
    },
    {
      "key": "B1",
      "label": [
        "admission_arbiter",
        "(round robin)"
      ],
      "width": 200,
      "row": 0,
      "col": 1,
      "row_name": "admission_arbiter (round robin)",
      "function": "Choose one eligible hart per cycle; apply source validity, the global OP-003 fence and free-slot checks without locking out other harts.",
      "source": "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 5.3.3"
    },
    {
      "key": "B3",
      "label": [
        "operand_capture",
        "(coupled issue/register)"
      ],
      "width": 280,
      "row": 0,
      "col": 2,
      "row_name": "operand_capture (coupled issue/register)",
      "function": "Capture the requested source lanes exactly once on the joint issue and register handshake.",
      "source": "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 5.3.1 (DEC-024)"
    },
    {
      "key": "B4",
      "label": [
        "commit_kill_match",
        "(hart, id)"
      ],
      "width": 200,
      "row": 1,
      "col": 1,
      "row_name": "commit_kill_match (hart, id)",
      "function": "Match each commit packet to an accepted command by hart and id; authorize descriptor fetch, DMA and result, or cancel a killed command and its suffix.",
      "source": "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 5.3.1"
    },
    {
      "key": "B2",
      "label": [
        "command_queue",
        "(contexts, scoreboard)"
      ],
      "width": 260,
      "row": 1,
      "col": 2,
      "row_name": "command_queue (contexts, scoreboard)",
      "function": "Keep accepted commands with mode, metadata, global dispatch order and the per-hart age used for kill decisions.",
      "source": "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 5.3.3"
    },
    {
      "key": "B6",
      "label": [
        "result_return",
        "(result, status)"
      ],
      "width": 200,
      "row": 2,
      "col": 1,
      "row_name": "result_return (result, status)",
      "function": "Return result and status with the matching hart and id, and keep the first-error record until it is cleared.",
      "source": "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 12.1"
    },
    {
      "key": "B5",
      "label": [
        "dispatch_scheduler",
        "(oldest authorized)"
      ],
      "width": 220,
      "row": 2,
      "col": 2,
      "row_name": "dispatch_scheduler (oldest authorized)",
      "function": "Start the oldest authorized context, route its tiles to the array copies, and gate output effects on matching authorization.",
      "source": "doc/tensor_coprocessor/VLSIT_TENSOR_COPROCESSOR_HDS.md section 5.3.3"
    }
  ],
