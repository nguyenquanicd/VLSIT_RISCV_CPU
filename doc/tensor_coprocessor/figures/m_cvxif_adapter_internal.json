  "interfaces": [
    {
      "id": "DEC",
      "name": "Local decode result to arbiter",
      "category": "handshake",
      "active": "B0 -> B1",
      "signals": "accept, register_read, requested source mask"
    },
    {
      "id": "ADM",
      "name": "Granted hart to operand capture",
      "category": "handshake",
      "active": "B1 -> B3",
      "signals": "issue, register, grant"
    },
    {
      "id": "QUE",
      "name": "Captured command to queue",
      "category": "custom",
      "active": "B3 -> B2",
      "signals": "instruction word, hart, id, rs1, rs2"
    },
    {
      "id": "AUTH",
      "name": "Authorization and kill to queue",
      "category": "handshake",
      "active": "B4 -> B2",
      "signals": "commit_valid, commit_kill, hart, id"
    },
    {
      "id": "RUN",
      "name": "Queue head to dispatch",
      "category": "custom",
      "active": "B2 -> B5",
      "signals": "mode, operation ID, precision, descriptor address"
    },
    {
      "id": "DONE",
      "name": "Completion to result return",
      "category": "handshake",
      "active": "B5 -> B6",
      "signals": "result data, status, hart, id"
    },
    {
      "id": "ISS",
      "name": "Issue and register inputs",
      "category": "handshake",
      "active": "in",
      "signals": "issue_valid, issue_req, register_valid, register, issue_ready, register_ready, issue_resp"
    },
    {
      "id": "CMT",
      "name": "Commit inputs",
      "category": "handshake",
      "active": "in",
      "signals": "commit_valid, commit.hartid, commit.id, commit.commit_kill"
    },
    {
      "id": "RESX",
      "name": "Result outputs",
      "category": "handshake",
      "active": "out",
      "signals": "result_valid, result_ready, result.hartid, result.id, result.data, result.rd, result.we"
    },
    {
      "id": "CTL",
      "name": "Dispatch outputs",
      "category": "custom",
      "active": "out",
      "signals": "active command, mode, tile counts"
    }
