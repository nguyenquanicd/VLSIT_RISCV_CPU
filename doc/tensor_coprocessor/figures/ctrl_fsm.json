{
  "page_name": "FSM_CTRL",
  "out_name": "ctrl_fsm.drawio",
  "function": "ctrl",
  "initial": "ENUM_ST_IDLE",
  "state_pattern": "^ENUM_ST_[A-Z0-9_]+$",
  "states": [
    {
      "name": "ENUM_ST_IDLE"
    },
    {
      "name": "ENUM_ST_DECODE"
    },
    {
      "name": "ENUM_ST_FETCH"
    },
    {
      "name": "ENUM_ST_COMPUTE"
    },
    {
      "name": "ENUM_ST_POST"
    },
    {
      "name": "ENUM_ST_WRITEBACK"
    },
    {
      "name": "ENUM_ST_ERR_DRAIN"
    },
    {
      "name": "ENUM_ST_ERROR"
    }
  ],
  "transitions": [
    {
      "src": "ENUM_ST_IDLE",
      "dst": "ENUM_ST_DECODE",
      "label": "issue accepted"
    },
    {
      "src": "ENUM_ST_DECODE",
      "dst": "ENUM_ST_FETCH",
      "label": "descriptor/control ready"
    },
    {
      "src": "ENUM_ST_DECODE",
      "dst": "ENUM_ST_ERR_DRAIN",
      "label": "accepted descriptor fault"
    },
    {
      "src": "ENUM_ST_FETCH",
      "dst": "ENUM_ST_COMPUTE",
      "label": "operands ready"
    },
    {
      "src": "ENUM_ST_FETCH",
      "dst": "ENUM_ST_ERR_DRAIN",
      "label": "read/descriptor fault"
    },
    {
      "src": "ENUM_ST_COMPUTE",
      "dst": "ENUM_ST_POST",
      "label": "tile phase complete"
    },
    {
      "src": "ENUM_ST_COMPUTE",
      "dst": "ENUM_ST_ERR_DRAIN",
      "label": "execution fault"
    },
    {
      "src": "ENUM_ST_POST",
      "dst": "ENUM_ST_FETCH",
      "label": "more tiles or phases"
    },
    {
      "src": "ENUM_ST_POST",
      "dst": "ENUM_ST_WRITEBACK",
      "label": "command complete"
    },
    {
      "src": "ENUM_ST_POST",
      "dst": "ENUM_ST_ERR_DRAIN",
      "label": "postprocess fault"
    },
    {
      "src": "ENUM_ST_WRITEBACK",
      "dst": "ENUM_ST_IDLE",
      "label": "result handshake"
    },
    {
      "src": "ENUM_ST_ERR_DRAIN",
      "dst": "ENUM_ST_ERROR",
      "label": "drained; status captured"
    },
    {
      "src": "ENUM_ST_ERROR",
      "dst": "ENUM_ST_IDLE",
      "label": "error result handshake"
    }
  ],
  "layout": {
    "margin": 40
  }
}
