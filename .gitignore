# Logs produced by lint, simulation, build and other tools
*.log
*.log.*
# Console captures of tool and regression runs
*.out
# CVA6 instruction traces written by simulation
trace_hart_*.dasm
# VLSIT rule-checker console reports
rtl/coherence_fix/rulecheck_*.txt

# Simulation waveform dumps (regenerate with the testbench run scripts)
*.vcd
*.fst
*.vpd
*.wlf

# Simulation run folders and coverage databases produced by the testbenches
verification/**/runs/
verification/*/coverage/
**/coverage/*.dat
# Hash-addressed replay snapshots written by the verification package helper (regenerable copies)
verification/*/snapshots/
# Report folders regenerated by the copied regression suites
verification/coherence_fix/reports/

# Synthesis and timing report archives exported from tool runs
syn/*.zip

# Python caches
__pycache__/
*.pyc

# Local tool caches and browser preview state
**/.test_tmp/
**/.chrome-preview/
**/Crashpad/

# Generated build products
**/build/
**/obj/
**/obj_dir/
*.o
*.obj
*.exe
*.dll
*.so
*.a

# Nested upstream Git metadata is retained on disk for provenance, not embedded
# as Git submodules in this project repository.
**/.git

# Generated full-project distribution archive (source and docs are committed directly)
/vlsit_multicore_riscv_cluster_v1.zip

# Arm standards are licensed for local reference only; keep the user-supplied conversion out of Git.
/doc/tensor_coprocessor/reference/md_doc/vlsit_axi_amba_axi_ihi0022h.md

# Vendor checkout metadata stays local; source and recorded pins live in the project.
project_support/provenance/third_party/*/
