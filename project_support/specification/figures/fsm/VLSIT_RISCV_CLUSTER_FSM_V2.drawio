        <mxCell id="FSM009_e007__2" value="unmapped address: DECERR; malformed policy TBD / địa chỉ chưa map: DECERR; quy tắc malformed còn TBD" style="endArrow=block;html=1;rounded=0;fontSize=18;strokeWidth=2;endFill=1;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" vlsit_library_sha256="D1631ACF98A920526B235E8970FEDDC9305EA2F0D6A35C6529CD220D62AFABB6" vlsit_library_entry="1" vlsit_library_cell="2" vlsit_library_instance="FSM009_e007" source="FSM009_error__2" target="FSM009_hold__2"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="440" y="912.5" as="sourcePoint" /><mxPoint x="550" y="1272.5" as="targetPoint" /><Array as="points"><mxPoint x="500" y="912.5" /><mxPoint x="500" y="1272.5" /></Array></mxGeometry></mxCell>
