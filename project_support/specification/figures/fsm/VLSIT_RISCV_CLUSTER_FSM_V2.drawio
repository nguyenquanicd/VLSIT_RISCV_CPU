        <mxCell id="FSM009_e003__2" value="YES: both request parts available / ĐỦ: đã có AW và W" style="endArrow=block;html=1;rounded=0;fontSize=18;strokeWidth=2;endFill=1;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" vlsit_library_sha256="D1631ACF98A920526B235E8970FEDDC9305EA2F0D6A35C6529CD220D62AFABB6" vlsit_library_entry="1" vlsit_library_cell="2" vlsit_library_instance="FSM009_e003" source="FSM009_pair__2" target="FSM009_decode__2"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="690" y="445" as="sourcePoint" /><mxPoint x="690" y="500" as="targetPoint" /></mxGeometry></mxCell>
