        <mxCell id="FSM009_e005__2" value="NO / KHÔNG" style="endArrow=block;html=1;rounded=0;fontSize=18;strokeWidth=2;endFill=1;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" vlsit_library_sha256="D1631ACF98A920526B235E8970FEDDC9305EA2F0D6A35C6529CD220D62AFABB6" vlsit_library_entry="1" vlsit_library_cell="2" vlsit_library_instance="FSM009_e005" source="FSM009_legal__2" target="FSM009_error__2"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="600" y="717.5" as="sourcePoint" /><mxPoint x="260" y="860" as="targetPoint" /><Array as="points"><mxPoint x="520" y="717.5" /><mxPoint x="260" y="717.5" /><mxPoint x="260" y="820" /></Array></mxGeometry></mxCell>
